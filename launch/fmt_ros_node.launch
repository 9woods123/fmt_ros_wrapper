

<launch>

    <node pkg="fmt_ros_wrapper" type="transform_ros_wrapper" name="transform_ros_wrapper" output="screen">
    </node>

    <node pkg="fmt_ros_wrapper" type="sensor_ros_wrapper" name="sensor_ros_wrapper" output="screen">
    </node>
  
    <node pkg="fmt_ros_wrapper" type="img_ros_wrapper" name="img_ros_wrapper" output="screen">
    </node>

    <node pkg="fmt_ros_wrapper" type="cmd2fmt" name="cmd2fmt" output="screen">
    </node>



</launch>

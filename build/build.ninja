  OBJECT_FILE_DIR = CMakeFiles/image_udp_receiver.dir/src
  TARGET_COMPILE_PDB = CMakeFiles/image_udp_receiver.dir/
  TARGET_PDB = devel/lib/libimage_udp_receiver.pdb


